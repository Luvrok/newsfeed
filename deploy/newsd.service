[Unit]
Description=Dispatch news collector
Documentation=https://github.com/barnard/newsfeed
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dispatch
Group=dispatch
WorkingDirectory=/opt/dispatch
Environment=NEWSFEED_CONFIG=/opt/dispatch/config/newsfeed.toml
# Optional: HTTPS_PROXY, NEWSFEED_PROXY, DISPATCH_WEB_DIR, etc.
EnvironmentFile=-/etc/newsd.env
ExecStart=/opt/dispatch/bin/newsd serve
Restart=on-failure
RestartSec=5

# The service only needs its own database directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/dispatch/data

[Install]
WantedBy=multi-user.target
